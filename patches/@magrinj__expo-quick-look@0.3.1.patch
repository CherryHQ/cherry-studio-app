+
+    override func viewWillAppear(_ animated: Bool) {
+        super.viewWillAppear(animated)
+        navigationItem.leftBarButtonItem = UIBarButtonItem(
+            barButtonSystemItem: .close,
+            target: self,
+            action: #selector(closePreview)
+        )
+    }
+
+    override func accessibilityPerformEscape() -> Bool {
+        closePreview()
+        return true
+    }
+
+    @objc private func closePreview() {
+        let previewDelegate = delegate as? PreviewDelegate
+        dismiss(animated: true) {
+            // Programmatic dismissal does not call the presentation delegate.
+            previewDelegate?.notifyDismissed()
+        }
+    }
+}
+
+class PreviewNavigationController: UINavigationController {
+    override func setNavigationBarHidden(_ hidden: Bool, animated: Bool) {
+        // Image previews can hide Quick Look's own controls. Keep an explicit exit visible.
+        super.setNavigationBarHidden(false, animated: animated)
+    }
 }
