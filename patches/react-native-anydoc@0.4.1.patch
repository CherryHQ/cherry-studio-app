diff --git a/android/build.gradle b/android/build.gradle
index 6c2b8d5a2ad8dea655036622a265e2c9c314bb50..f1b3b5d7d8b64c7d821bde71e76f4e66cb22184a 100644
--- a/android/build.gradle
+++ b/android/build.gradle
@@ -14,6 +14,10 @@ apply plugin: 'org.jetbrains.kotlin.android'
 android {
   namespace "com.tula.anydoc"
   compileSdkVersion rootProject.hasProperty('compileSdkVersion') ? rootProject.compileSdkVersion : 35
+  // Build with the app's NDK instead of AGP's default.
+  if (rootProject.ext.has("ndkVersion")) {
