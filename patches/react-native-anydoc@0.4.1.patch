+  }
 
   defaultConfig {
     minSdkVersion rootProject.hasProperty('minSdkVersion') ? rootProject.minSdkVersion : 24
@@ -32,7 +36,8 @@ android {
     externalNativeBuild {
       cmake {
         cppFlags "-frtti -fexceptions -Wall -fstack-protector-all"
-        arguments "-DANDROID_STL=c++_shared"
