@@ -0,0 +1,41 @@
+package expo.modules.linking
+
+import android.content.Intent
+import android.net.Uri
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+import org.junit.runner.RunWith
+
+@RunWith(AndroidJUnit4::class)
+class ConsumeURLTest {
+  private val account = "cherrystudio://auth/callback?code=cold"
+  private val other = "cherrystudio://oauth/callback?code=other"
+
+  @Test fun retireOldLaunchWithoutClearingANewerReceivedLink() {
+    val launch = Intent(Intent.ACTION_VIEW).apply {
+      setDataAndType(Uri.parse(account), "text/plain")
+      putExtra("keep", 7)
+    }
+    ExpoLinkingModule.initialURL = Uri.parse(other)
+    try {
+      ExpoLinkingModule.consumeURL(launch, account)
+      assertNull(launch.data)
+      assertEquals(other, ExpoLinkingModule.initialURL?.toString())
+      assertEquals(Intent.ACTION_VIEW, launch.action)
+      assertEquals("text/plain", launch.type)
+      assertEquals(7, launch.getIntExtra("keep", 0))
+    } finally {
+      ExpoLinkingModule.initialURL = null
+    }
+  }
+
+  @Test fun retireReceivedLinkWithoutClearingADifferentLaunch() {
+    val launch = Intent(Intent.ACTION_VIEW, Uri.parse(other))
+    ExpoLinkingModule.initialURL = Uri.parse(account)
+    ExpoLinkingModule.consumeURL(launch, account)
+    assertNull(ExpoLinkingModule.initialURL)
+    assertEquals(other, launch.dataString)
+  }
+}
