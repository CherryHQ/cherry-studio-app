+++ b/dist/auth/oauth/callback-server.native.js
@@ -0,0 +1,50 @@
+// Native apps use the official manual-code fallback; they do not run a TCP listener.
+export async function startOAuthCallbackServer(options) {
+    options.signal?.throwIfAborted();
+    let resolveWait;
+    let rejectWait;
+    const promise = new Promise((resolve, reject) => { resolveWait = resolve; rejectWait = reject; });
+    promise.catch(() => undefined);
+    const abort = () => rejectWait(new Error("Login cancelled"));
+    options.signal?.addEventListener("abort", abort, { once: true });
+    const timer = setTimeout(() => rejectWait(new Error("Login timed out")), options.timeoutMs ?? 300000);
+    return {
+        redirectUri: `http://127.0.0.1:1455${options.path}`,
+        wait: () => promise,
+        cancel: () => resolveWait(undefined),
+        close: () => {
+            clearTimeout(timer);
+            options.signal?.removeEventListener("abort", abort);
+            resolveWait(undefined);
+        },
+    };
+}
+export async function waitForCallbackOrManualInput(interaction, callback, prompt) {
+    const manualAbort = new AbortController();
+    let manualError;
+    const manual = interaction
+        .prompt({ type: "manual_code", ...prompt, signal: manualAbort.signal })
+        .then((input) => {
+        callback?.cancel();
+        return input;
+    })
+        .catch((error) => {
+        manualError = error instanceof Error ? error : new Error(String(error));
+        callback?.cancel();
+        return undefined;
+    });
+    try {
+        const value = await callback?.wait();
+        if (manualError)
+            throw manualError;
+        if (value !== undefined)
+            return { type: "callback", value };
+        const input = await manual;
+        if (manualError)
+            throw manualError;
+        return { type: "manual", input: input ?? "" };
+    }
+    finally {
+        manualAbort.abort();
+    }
+}
