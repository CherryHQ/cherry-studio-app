+function readVerifiedArchive(filePath) {
+  let bytes;
+  try {
+    bytes = fs.readFileSync(filePath);
+  } catch (error) {
+    if (error.code === 'ENOENT') return null;
+    throw error;
+  }
+  return createHash('sha256').update(bytes).digest('hex') === ARCHIVE_SHA256 ? bytes : null;
+}
+
+async function downloadArchive(url, output) {
+  const curl = spawn(
+    'curl',
+    [
+      '--fail',
+      '--location',
+      '--proto',
+      '=https',
+      '--proto-redir',
+      '=https',
+      '--retry',
+      '3',
+      '--connect-timeout',
+      '20',
+      '--speed-limit',
+      '1',
+      '--speed-time',
+      '120',
+      '--output',
+      output,
+      url,
+    ],
+    { env: process.env, stdio: ['ignore', 'ignore', 'inherit'] }
+  );
+  try {
+    const [code, signal] = await once(curl, 'close');
+    if (code !== 0) {
+      throw new Error(`Sherpa ONNX download failed (${signal ?? code}).`);
+    }
+  } catch (error) {
+    if (error.code !== 'ENOENT') throw error;
+    await downloadFile(url, output);
+  }
+}
+
+async function loadVerifiedArchive() {
+  const cacheDir = path.resolve(
+    process.env.XDG_CACHE_HOME || path.join(os.homedir(), '.cache'),
+    'cherry-studio-app',
+    'sherpa-onnx'
+  );
+  const cachePath = path.join(cacheDir, `sherpa-onnx-${BINARY_VERSION}-${ARCHIVE_SHA256}.zip`);
+  const cached = readVerifiedArchive(cachePath);
+  if (cached) {
+    console.log(`Using verified Sherpa ONNX ${BINARY_VERSION} archive from the local cache.`);
+    return cached;
+  }
+
+  fs.mkdirSync(cacheDir, { recursive: true });
+  const stagingDir = fs.mkdtempSync(path.join(cacheDir, '.download-'));
+  const stagedFile = path.join(stagingDir, 'archive.zip');
+  try {
+    await downloadArchive(RELEASE_URL, stagedFile);
+    const bytes = readVerifiedArchive(stagedFile);
+    if (!bytes) {
+      throw new Error(`Sherpa ONNX ${BINARY_VERSION} archive SHA-256 mismatch.`);
+    }
+    fs.renameSync(stagedFile, cachePath);
+    return bytes;
+  } finally {
+    fs.rmSync(stagingDir, { recursive: true, force: true });
+  }
+}
