diff --git a/scripts/prepare-archive.cjs b/scripts/prepare-archive.cjs
new file mode 100644
--- /dev/null
+++ b/scripts/prepare-archive.cjs
@@ -0,0 +1,55 @@
+const { spawn } = require('node:child_process');
+const { createHash } = require('node:crypto');
+const { once } = require('node:events');
+const { createReadStream } = require('node:fs');
+const { mkdir, mkdtemp, rename, rm } = require('node:fs/promises');
+const { homedir } = require('node:os');
+const { join, resolve } = require('node:path');
+const { sherpaOnnxVersion: version, sherpaOnnxArchiveSha256: digest } = require('../package.json');
+const { releaseAssetUrl } = require('./sherpa-prebuilt-contract');
+
+async function sha256(file) {
+  const hash = createHash('sha256');
+  for await (const chunk of createReadStream(file)) hash.update(chunk);
+  return hash.digest('hex');
+}
+
+async function downloadArchive(url, output, env, fallbackDownload) {
+  const curl = spawn('curl', [
+    '--fail', '--location', '--proto', '=https', '--proto-redir', '=https',
+    '--retry', '3', '--connect-timeout', '20', '--speed-limit', '1', '--speed-time', '120',
+    '--output', output, url,
+  ], { env, stdio: ['ignore', 'ignore', 'inherit'] });
+  try {
+    const [code, signal] = await once(curl, 'close');
+    if (code !== 0) throw new Error(`Sherpa ONNX download failed (${signal ?? code}).`);
+  } catch (error) {
+    if (error.code !== 'ENOENT' || !fallbackDownload) throw error;
+    await fallbackDownload(url, output);
+  }
+}
+
+module.exports = async function prepareSherpaArchive(env = process.env, fallbackDownload) {
+  const cache = resolve(env.XDG_CACHE_HOME || join(homedir(), '.cache'), 'cherry-studio-app', 'sherpa-onnx');
+  const archive = join(cache, `sherpa-onnx-${version}-${digest}.zip`);
+  try {
+    if (await sha256(archive) === digest) {
+      console.log(`Using verified Sherpa ONNX ${version} archive from the local cache.`);
+      return archive;
+    }
+  } catch (error) {
+    if (error.code !== 'ENOENT') throw error;
+  }
+
+  await mkdir(cache, { recursive: true });
+  const staging = await mkdtemp(join(cache, '.download-'));
+  const file = join(staging, 'archive.zip');
+  try {
+    await downloadArchive(releaseAssetUrl(version), file, env, fallbackDownload);
+    if (await sha256(file) !== digest) throw new Error(`Sherpa ONNX ${version} archive SHA-256 mismatch.`);
+    await rename(file, archive);
+    return archive;
+  } finally {
+    await rm(staging, { recursive: true, force: true });
+  }
+};
