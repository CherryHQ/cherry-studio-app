@@ -4,6 +4,7 @@ internal import React
 
 public class CalendarPermissionsRequester: NSObject, EXPermissionsRequester {
   private let eventStore: EKEventStore
+  private let fullAccessRequestedKey = "cherry.calendar.fullAccessRequested"
 
   init(eventStore: EKEventStore) {
     self.eventStore = eventStore
@@ -31,9 +32,17 @@ public class CalendarPermissionsRequester: NSObject, EXPermissionsRequester {
     }
 
     switch permissions {
-    case .restricted, .denied, .writeOnly:
+    case .restricted, .denied:
       status = EXPermissionStatusDenied
+    case .writeOnly:
+      // Add-only access leaves one opportunity to ask for full access. EventKit
+      // keeps writeOnly after a refused upgrade, so retain that attempt across launches.
+      status = UserDefaults.standard.bool(forKey: fullAccessRequestedKey)
+        ? EXPermissionStatusDenied
