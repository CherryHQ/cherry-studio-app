 import org.junit.Test
 
 class NativeRequestTest {
@@ -30,4 +33,29 @@
     assertThat(body).isNotNull()
     assertThat(body!!.contentLength()).isEqualTo(5L)
   }
+
+  @Test
+  fun `large request bodies use bounded buffering and can be replayed`() {
+    val bytes = ByteArray(64 * 1024 + 7) { (it % 251).toByte() }
+    val body = buildRequestBody("POST", bytes, jsonMediaType)!!
+    assertThat(body.contentLength()).isEqualTo(bytes.size.toLong())
+    assertThat(body.contentType()).isEqualTo(jsonMediaType)
+
+    repeat(2) {
+      val received = Buffer()
+      var largestPendingBuffer = 0L
+      val sink = object : ForwardingSink(received) {
+        override fun write(source: Buffer, byteCount: Long) {
+          largestPendingBuffer = maxOf(largestPendingBuffer, source.size)
+          super.write(source, byteCount)
+        }
+      }.buffer()
+
+      body.writeTo(sink)
+      assertThat(sink.isOpen).isTrue()
+      sink.flush()
+      assertThat(received.readByteArray()).isEqualTo(bytes)
+      assertThat(largestPendingBuffer).isAtMost(8192L)
+    }
+  }
 }
