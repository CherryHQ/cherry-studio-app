index 3cdbd778034d908a2235b993518b0c4c9ad0851a..6cde4f86792a2c69e0d50cb8ed707b607fb0fab4 100644
--- a/bundleMode/index.js
+++ b/bundleMode/index.js
@@ -1,6 +1,7 @@
 /* eslint-disable */
 // @ts-nocheck
 const path = require('path');
+const fs = require('fs');
 
 let getDefaultConfig = () => ({});
 try {
@@ -9,11 +10,41 @@ try {
   /* empty */
 }
 
-const workletsPackageParentDir = path.resolve(__dirname, '../..');
+const workletsPackageDir = path.resolve(__dirname, '..');
 
 const defaults = getDefaultConfig(__dirname);
 
-const workletsDirPath = path.join('react-native-worklets', '.worklets');
+const workletsDirPath = 'react-native-worklets/.worklets';
+
+function resolveRelativePathFromWorklets(context, moduleName) {
+  // Handle relative path imports from within .worklets files
+  // (e.g., "..\\src\\memory\\serializable" with backslashes)
+  if (!context.originModulePath?.includes('.worklets')) {
+    return null;
+  }
+
+  const normalizedModuleName = moduleName.replace(/\\/g, '/');
+  const resolvedPath = path.resolve(path.dirname(context.originModulePath), normalizedModuleName);
+
+  // Try to resolve with different extensions
+  const extensions = ['.ts', '.tsx', '.js', '.jsx', '.native.ts', '.native.js'];
+  for (const ext of extensions) {
+    const fullPath = resolvedPath + ext;
+    if (fs.existsSync(fullPath)) {
+      return { type: 'sourceFile', filePath: fullPath };
+    }
+  }
+
+  // Also try as directory with index file
+  for (const ext of extensions) {
+    const indexPath = path.join(resolvedPath, 'index' + ext);
+    if (fs.existsSync(indexPath)) {
+      return { type: 'sourceFile', filePath: indexPath };
+    }
+  }
+
+  return null;
+}
 
 function bundleModeResolveRequest(
   /** @type {any} */ context,
@@ -21,9 +52,16 @@ function bundleModeResolveRequest(
   /** @type {any} */ platform
 ) {
   if (moduleName.startsWith(workletsDirPath)) {
-    const fullModuleName = path.join(workletsPackageParentDir, moduleName);
+    const fileName = moduleName.replace(workletsDirPath + '/', '');
+    const fullModuleName = path.join(workletsPackageDir, '.worklets', fileName);
     return { type: 'sourceFile', filePath: fullModuleName };
   }
+
+  const relativeResult = resolveRelativePathFromWorklets(context, moduleName);
+  if (relativeResult) {
+    return relativeResult;
+  }
+
   return context.resolveRequest(context, moduleName, platform);
 }
 
@@ -46,9 +84,16 @@ const bundleModeMetroConfig = {
       /** @type {any} */ platform
     ) => {
       if (moduleName.startsWith(workletsDirPath)) {
-        const fullModuleName = path.join(workletsPackageParentDir, moduleName);
+        const fileName = moduleName.replace(workletsDirPath + '/', '');
+        const fullModuleName = path.join(workletsPackageDir, '.worklets', fileName);
         return { type: 'sourceFile', filePath: fullModuleName };
       }
+
+      const relativeResult = resolveRelativePathFromWorklets(context, moduleName);
+      if (relativeResult) {
+        return relativeResult;
+      }
+
       return context.resolveRequest(context, moduleName, platform);
     },
   },
@@ -62,9 +107,9 @@ function getBundleModeMetroConfig(config) {
   config.serializer.getModulesRunBeforeMainModule = (
     /** @type {string} dirname */ dirname
   ) => [
-    ...getEntryPoints(),
-    ...(currentGetModulesRunBeforeMainModule?.(dirname) || []),
-  ];
+      ...getEntryPoints(),
+      ...(currentGetModulesRunBeforeMainModule?.(dirname) || []),
+    ];
 
   config.serializer.createModuleIdFactory = bundleModeCreateModuleIdFactory;
 
