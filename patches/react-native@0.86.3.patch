+  ValueT getWithGeneratorOutsideLock(const KeyT &key, CacheGeneratorFunction<ValueT> auto generator) const
+  {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (auto it = map_.find(key); it != map_.end()) {
+        list_.splice(list_.begin(), list_, it->second);
+        return it->second->second;
+      }
+    }
+
+    // Native text measurement can synchronously deliver notifications that wait
+    // on another thread. Never hold the cache mutex across that work.
+    auto value = generator();
+
+    std::lock_guard<std::mutex> lock(mutex_);
+    // Recheck after generation and copy the result before unlocking, so another
+    // thread cannot evict the entry while it is being read.
+    return getMapIterator(key, [&value]() { return std::move(value); })->second->second;
