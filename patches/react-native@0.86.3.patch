+TEST(EvictingCacheMapTest, GeneratorCanWaitForAnotherThreadUsingTheCache) {
+  SimpleThreadSafeCache<int, std::string, 3> cache;
+  cache.getWithGeneratorOutsideLock(0, []() { return std::string("zero"); });
+
+  std::promise<void> generating;
+  auto generatingFuture = generating.get_future();
+  std::promise<void> callbackFinished;
+  auto callbackFinishedFuture = callbackFinished.get_future();
+  // Model native measurement waiting for a notification callback whose thread
+  // must also measure text. A timeout lets a regressed cache fail without hanging.
+  auto blocked = std::async(std::launch::async, [&]() {
+    return cache.getWithGeneratorOutsideLock(1, [&]() {
+      generating.set_value();
+      auto status = callbackFinishedFuture.wait_for(std::chrono::seconds(5));
+      return status == std::future_status::ready ? std::string("one") : std::string("callback timed out");
+    });
+  });
+
+  EXPECT_EQ(
+      generatingFuture.wait_for(std::chrono::seconds(5)),
+      std::future_status::ready);
+  auto hit = cache.getWithGeneratorOutsideLock(0, []() { return std::string("unexpected"); });
+  auto miss = cache.getWithGeneratorOutsideLock(2, []() { return std::string("two"); });
+  callbackFinished.set_value();
+
+  EXPECT_EQ(blocked.get(), "one");
+  EXPECT_EQ(hit, "zero");
+  EXPECT_EQ(miss, "two");
+}
+
+TEST(EvictingCacheMapTest, ConcurrentMissReusesStoredValueAndUpdatesRecency) {
+  SimpleThreadSafeCache<int, std::string, 2> cache;
+  std::promise<void> generating;
+  auto generatingFuture = generating.get_future();
+  std::promise<void> resume;
+  auto resumeFuture = resume.get_future();
+  auto slow = std::async(std::launch::async, [&]() {
+    return cache.getWithGeneratorOutsideLock(1, [&]() {
+      generating.set_value();
+      resumeFuture.wait();
+      return std::string("slow");
+    });
+  });
+
+  EXPECT_EQ(
+      generatingFuture.wait_for(std::chrono::seconds(5)),
+      std::future_status::ready);
+  auto first = std::async(std::launch::async, [&]() {
+    auto value = cache.getWithGeneratorOutsideLock(1, []() { return std::string("first"); });
+    cache.getWithGeneratorOutsideLock(2, []() { return std::string("two"); });
+    return value;
+  });
+  auto status = first.wait_for(std::chrono::seconds(5));
+  resume.set_value();
+
+  EXPECT_EQ(status, std::future_status::ready);
+  EXPECT_EQ(first.get(), "first");
+  EXPECT_EQ(slow.get(), "first");
+  cache.getWithGeneratorOutsideLock(3, []() { return std::string("three"); });
+  EXPECT_EQ(cache.get(1), "first");
+  EXPECT_EQ(cache.get(2), "");
+  EXPECT_EQ(cache.get(3), "three");
+}
+
+TEST(EvictingCacheMapTest, CacheHitSkipsGeneratorAndUpdatesRecency) {
+  SimpleThreadSafeCache<int, std::string, 2> cache;
+  cache.getWithGeneratorOutsideLock(1, []() { return std::string("one"); });
+  cache.getWithGeneratorOutsideLock(2, []() { return std::string("two"); });
+  auto generated = false;
+  auto hit = cache.getWithGeneratorOutsideLock(1, [&]() {
+    generated = true;
+    return std::string("unexpected");
+  });
+  EXPECT_EQ(hit, "one");
+  EXPECT_FALSE(generated);
+  cache.getWithGeneratorOutsideLock(3, []() { return std::string("three"); });
+  EXPECT_EQ(cache.get(1), "one");
+  EXPECT_EQ(cache.get(2), "");
+}
+
+TEST(EvictingCacheMapTest, ReturnedValueSurvivesEviction) {
+  SimpleThreadSafeCache<int, std::shared_ptr<int>, 1> cache;
+  auto one = cache.getWithGeneratorOutsideLock(1, []() { return std::make_shared<int>(1); });
+  cache.getWithGeneratorOutsideLock(2, []() { return std::make_shared<int>(2); });
+  EXPECT_EQ(*one, 1);
+  EXPECT_EQ(one.use_count(), 1);
+}
+
+TEST(EvictingCacheMapTest, PointerLookupStillReusesStoredEntry) {
+  SimpleThreadSafeCache<int, std::string, 2> cache;
+  const auto [key, value] = cache.getWithKey(1, []() { return std::string("one"); });
+  EXPECT_EQ(*key, 1);
+  EXPECT_EQ(*value, "one");
+  auto generated = false;
+  const auto [cachedKey, cachedValue] = cache.getWithKey(1, [&]() {
+    generated = true;
+    return std::string("unexpected");
+  });
+  EXPECT_FALSE(generated);
+  EXPECT_EQ(cachedKey, key);
+  EXPECT_EQ(cachedValue, value);
+}
+
 } // namespace facebook::react
