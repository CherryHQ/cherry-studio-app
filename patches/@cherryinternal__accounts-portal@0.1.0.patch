+/** Display fields are separate from the unmasked login name. Neither identifies a data profile. */
+export interface AccountIdentity {
+    readonly displayName?: string;
+    readonly username?: string;
+    readonly maskedIdentifier?: string;
+}
+/** Matches the existing Enterprise/Passport contact-based display-name convention. */
+export declare const maskAccountIdentifier: (value: string) => string;
+export declare const accountIdentity: (claims: Record<string, unknown>) => AccountIdentity;
