+const text = (value) => typeof value === "string" && value.trim() ? value.trim() : undefined;
+const phone = (value) => {
+    const compact = value.replace(/[\s()-]/g, "");
+    if (/^1[3-9]\d{9}$/.test(compact))
+        return `+86${compact}`;
+    return /^\+\d{8,15}$/.test(compact) ? compact : undefined;
+};
+/** Matches the existing Enterprise/Passport contact-based display-name convention. */
+export const maskAccountIdentifier = (value) => {
+    const deliveryName = /^\+86 (1[3-9]\d)\*{4}(\d{4})$/.exec(value);
+    if (deliveryName)
+        return `+861****${deliveryName[2]}`;
+    const number = phone(value);
+    if (number)
+        return `${number.slice(0, 4)}****${number.slice(-4)}`;
+    const email = /^([^@\s]+)@([^@\s]+)$/.exec(value);
+    if (email)
+        return `${email[1]?.slice(0, 1)}***@${email[2]}`;
+    return value;
+};
+export const accountIdentity = (claims) => {
+    const username = text(claims.preferred_username);
+    const name = text(claims.name);
+    const identifier = text(claims.phone_number) ?? text(claims.email) ?? username;
+    return {
+        ...(name ? { displayName: maskAccountIdentifier(name) } : {}),
+        ...(username ? { username } : {}),
+        ...(identifier
+            ? { maskedIdentifier: maskAccountIdentifier(identifier) }
+            : {}),
+    };
+};
+//# sourceMappingURL=AccountIdentity.js.map
