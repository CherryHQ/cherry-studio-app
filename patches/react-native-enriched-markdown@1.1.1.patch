diff --git a/ios/input/ENRMInputMeasurement.mm b/ios/input/ENRMInputMeasurement.mm
new file mode 100644
--- /dev/null
+++ b/ios/input/ENRMInputMeasurement.mm
@@ -0,0 +1,83 @@
+#import "ENRMInputMeasurement.h"
+
+#if !TARGET_OS_OSX
+static NSAttributedStringKey const ENRMInputAttachmentBounds = @"ENRMInputAttachmentBounds";
+#endif
+
+static NSDictionary *ENRMInputLayoutAttributes(NSDictionary *attributes)
+{
+  // NSAttributedString interns equal attribute dictionaries. Distinguish these
+  // runs from live text so an immutable paragraph copy cannot be substituted
+  // with an equal, already-interned NSMutableParagraphStyle from the editor.
+  NSMutableDictionary *result = [@{@"ENRMInputMeasurement" : @YES} mutableCopy];
+  // Keep only layout data. In particular, never carry a live attachment (or a
+  // view-backed attachment provider) across threads with an attributed string.
+  for (NSAttributedStringKey key in @[
+         NSFontAttributeName, NSKernAttributeName, NSLigatureAttributeName, NSBaselineOffsetAttributeName,
+         NSObliquenessAttributeName, NSExpansionAttributeName, NSVerticalGlyphFormAttributeName,
+         NSParagraphStyleAttributeName, NSWritingDirectionAttributeName, @"NSOriginalFont"
+       ]) {
+    id value = attributes[key];
+    if (value) {
+      result[key] = [value copy];
+    }
+  }
+#if !TARGET_OS_OSX
+  NSTextAttachment *attachment = attributes[NSAttachmentAttributeName];
+  if (attachment) {
+    result[ENRMInputAttachmentBounds] = [NSValue valueWithCGRect:attachment.bounds];
+  }
+#endif
+  return result;
+}
+
+NSAttributedString *ENRMInputMeasurementText(NSAttributedString *text, NSDictionary *typingAttributes)
+{
+  NSMutableAttributedString *snapshot = [[NSMutableAttributedString alloc] initWithString:text.string];
+  [text enumerateAttributesInRange:NSMakeRange(0, text.length)
+                          options:0
+                       usingBlock:^(NSDictionary *attributes, NSRange range, BOOL *stop) {
+                         [snapshot setAttributes:ENRMInputLayoutAttributes(attributes) range:range];
+                       }];
+
+  // Match the editor's existing measurement: empty input has one line, and a
+  // trailing newline contributes a final line using the current typing font.
+  if (snapshot.length == 0 ||
+      [[NSCharacterSet newlineCharacterSet] characterIsMember:[snapshot.string characterAtIndex:snapshot.length - 1]]) {
+    [snapshot appendAttributedString:[[NSAttributedString alloc]
+                                         initWithString:@"I"
+                                             attributes:ENRMInputLayoutAttributes(typingAttributes)]];
+  }
+  return [snapshot copy];
+}
+
+CGSize ENRMMeasureInputText(NSAttributedString *text, CGFloat maxWidth)
+{
+  @autoreleasepool {
+    NSAttributedString *measuredText = text;
+#if !TARGET_OS_OSX
+    // TextKit may mutate attachment bookkeeping during layout. Materialize
+    // independent, geometry-only attachments for this measurement, not shared
+    // NSTextAttachment instances retained by the editor or another measure.
+    __block NSMutableAttributedString *withAttachments = nil;
+    [text enumerateAttribute:ENRMInputAttachmentBounds
+                     inRange:NSMakeRange(0, text.length)
+                     options:0
+                  usingBlock:^(NSValue *bounds, NSRange range, BOOL *stop) {
+                    if (!bounds) return;
+                    if (!withAttachments) withAttachments = [text mutableCopy];
+                    NSTextAttachment *attachment = [NSTextAttachment new];
+                    attachment.bounds = bounds.CGRectValue;
+                    [withAttachments addAttribute:NSAttachmentAttributeName value:attachment range:range];
+                    [withAttachments removeAttribute:ENRMInputAttachmentBounds range:range];
+                  }];
+    if (withAttachments) measuredText = withAttachments;
+#endif
+    NSStringDrawingContext *context = [NSStringDrawingContext new];
+    CGRect boundingBox =
+        [measuredText boundingRectWithSize:CGSizeMake(maxWidth, CGFLOAT_MAX)
+                                   options:NSStringDrawingUsesLineFragmentOrigin | NSStringDrawingUsesFontLeading
+                                   context:context];
+    return CGSizeMake(maxWidth, ceil(boundingBox.size.height));
+  }
+}
