{
  "name": "cherry-studio-app",
  "main": "index.ts",
  "version": "0.5.0",
  "engines": {
    "node": "24.x"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-notifications",
          "expo-app-metrics",
          "expo-observe"
        ]
      }
    }
  },
  "scripts": {
    "build:local": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/buildLocal.ts",
    "update:check": "node --import tsx scripts/publishUpdate.ts check",
    "update:preview": "node --import tsx scripts/publishUpdate.ts publish preview",
    "dev": "PROFILE=development expo start --dev-client",
    "dev:clear": "PROFILE=development expo start --dev-client --clear",
    "start": "PROFILE=development expo start --dev-client",
    "start:clear": "PROFILE=development expo start --dev-client --clear",
    "storybook": "PROFILE=development EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --dev-client",
    "storybook:clear": "PROFILE=development EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --dev-client --clear",
    "android": "PROFILE=development expo run:android",
    "ios": "PROFILE=development expo run:ios",
    "ios:dev": "PROFILE=development expo run:ios",
    "prebuild": "PROFILE=\"${PROFILE-development}\" expo prebuild",
    "db:generate": "drizzle-kit generate",
    "ui:icons:generate": "tsx packages/ui/src/scripts/generate-icons.ts",
    "ui:icons:generate:webp": "tsx packages/ui/src/scripts/generate-icons.ts",
    "ui:icons:generate:general": "tsx packages/ui/src/scripts/generate-icons.ts --type=general",
    "ui:icons:generate:models": "tsx packages/ui/src/scripts/generate-icons.ts --type=models",
    "ui:provider-icons:generate": "tsx packages/ui/src/scripts/generate-icons.ts --type=providers",
    "ui:check-boundaries": "tsx packages/ui/src/scripts/check-platform-boundaries.ts",
    "design:build": "tsx packages/design-tokens/scripts/build-native-css.ts",
    "design:sync": "tsx packages/design-tokens/scripts/sync-desktop.ts",
    "design:check": "tsx packages/design-tokens/scripts/check.ts && tsx packages/design-tokens/scripts/check-app-theme.ts && tsx packages/ui/src/scripts/check-icons.ts",
    "skills:sync": "tsx scripts/skillsSync.ts",
    "skills:check": "tsx scripts/skillsCheck.ts",
    "docs:check-links": "tsx scripts/checkDocLinks.ts",
    "i18n:check": "tsx scripts/i18n.ts check",
    "i18n:sync": "tsx scripts/i18n.ts sync",
    "test": "pnpm test:packages && pnpm test:app",
    "test:ai-contract": "jest src/backend/ai/__tests__/behavior --runInBand",
    "test:app": "jest",
    "test:packages": "pnpm test:ai-runtime",
    "test:ai-runtime": "pnpm --filter @cherrystudio/ai-runtime test",
    "typecheck": "pnpm typecheck:packages && pnpm typecheck:app",
    "typecheck:app": "tsc --noEmit",
    "typecheck:packages": "pnpm --filter @cherrystudio/ai-runtime typecheck && pnpm --filter @cherrystudio/file-preview-webview typecheck",
    "lint": "oxlint && expo lint",
    "lint:fix": "oxlint --fix && expo lint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "prek install"
  },
