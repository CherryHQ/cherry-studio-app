{
  "name": "cherry-studio-app",
  "main": "index.ts",
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "packages:build": "pnpm --filter @cherrystudio/ai-sdk-provider build && pnpm --filter @cherrystudio/ai-core build",
    "eas-build-post-install": "pnpm packages:build",
    "dev": "pnpm packages:build && expo start --dev-client",
    "dev:clear": "pnpm packages:build && expo start --dev-client --clear",
    "start": "pnpm packages:build && expo start --dev-client",
    "start:clear": "pnpm packages:build && expo start --dev-client --clear",
    "storybook": "pnpm packages:build && EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --dev-client",
    "storybook:clear": "pnpm packages:build && EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --dev-client --clear",
    "android": "pnpm packages:build && expo run:android",
    "ios": "pnpm packages:build && expo run:ios",
    "ios:dev": "pnpm packages:build && expo run:ios",
    "prebuild": "expo prebuild",
    "db:generate": "drizzle-kit generate",
    "ui:icons:generate": "tsx packages/ui/src/scripts/generate-icons.ts",
    "ui:icons:generate:webp": "tsx packages/ui/src/scripts/generate-icons.ts",
    "ui:icons:generate:general": "tsx packages/ui/src/scripts/generate-icons.ts --type=general",
    "ui:icons:generate:models": "tsx packages/ui/src/scripts/generate-icons.ts --type=models",
    "ui:provider-icons:generate": "tsx packages/ui/src/scripts/generate-icons.ts --type=providers",
    "design:build": "tsx packages/design-tokens/scripts/build-native-css.ts",
    "design:sync": "tsx packages/design-tokens/scripts/sync-desktop.ts",
    "design:check": "tsx packages/design-tokens/scripts/check.ts && tsx packages/design-tokens/scripts/check-app-theme.ts && tsx packages/ui/src/scripts/check-icons.ts",
    "desktop:sync:audit": "tsx scripts/desktopSyncAudit.ts",
    "skills:sync": "tsx scripts/skills-sync.ts",
    "skills:check": "tsx scripts/skills-check.ts",
    "docs:check-links": "tsx scripts/check-doc-links.ts",
    "test": "pnpm packages:build && pnpm test:packages && pnpm test:app",
    "test:ai-contract": "jest src/backend/ai/__tests__/behavior --runInBand",
    "test:app": "jest",
    "test:packages": "pnpm test:ai-sdk-provider && pnpm test:ai-core && pnpm test:ai-runtime",
    "test:ai-runtime": "pnpm --filter @cherrystudio/ai-runtime test",
    "test:ai-sdk-provider": "pnpm --filter @cherrystudio/ai-sdk-provider test",
    "test:ai-core": "pnpm --filter @cherrystudio/ai-core test",
    "typecheck": "pnpm packages:build && pnpm typecheck:packages && pnpm typecheck:app",
    "typecheck:app": "tsc --noEmit",
    "typecheck:packages": "pnpm --filter @cherrystudio/ai-sdk-provider exec tsc --noEmit -p tsconfig.json --lib ES2022,DOM,DOM.Iterable && pnpm --filter @cherrystudio/ai-core typecheck && pnpm --filter @cherrystudio/ai-runtime typecheck",
    "lint": "oxlint && expo lint",
    "lint:fix": "oxlint --fix && expo lint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "prek install"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.96",
    "@ai-sdk/anthropic": "^3.0.79",
    "@ai-sdk/cerebras": "^2.0.54",
    "@ai-sdk/gateway": "^3.0.121",
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/google-vertex": "^4.0.112",
    "@ai-sdk/groq": "^3.0.39",
