    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/openai-compatible": "2.0.62",
    "@ai-sdk/perplexity": "^3.0.33",
    "@ai-sdk/provider": "^3.0.14",
    "@ai-sdk/provider-utils": "4.0.40",
    "@ai-sdk/togetherai": "^2.0.53",
    "@ai-sdk/xai": "3.0.111",
    "@babel/runtime": "^7.29.2",
    "@cherrystudio/ai-core": "workspace:*",
    "@cherrystudio/ai-runtime": "workspace:*",
    "@cherrystudio/ai-sdk-provider": "workspace:*",
    "@cherrystudio/app-icons": "workspace:*",
    "@cherrystudio/design-tokens": "workspace:*",
