    "@cherrystudio/ui": "workspace:*",
    "@expo/dom-webview": "^57.0.0",
    "@expo/ui": "~57.0.2",
    "@legendapp/list": "3.3.0",
    "@magrinj/expo-quick-look": "^0.3.1",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@shopify/react-native-skia": "2.6.2",
