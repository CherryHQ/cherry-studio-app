    "expo-calendar": "~57.0.1",
    "expo-clipboard": "^57.0.1",
    "expo-constants": "~57.0.5",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.6",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-manipulator": "~57.0.11",
    "expo-image-picker": "~57.0.4",
    "expo-intent-launcher": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.6",
    "expo-media-library": "~57.0.2",
    "expo-paste-input": "0.2.2",
    "expo-router": "~57.0.6",
    "expo-screen-corner-radius": "^1.1.0",
    "expo-splash-screen": "~57.0.4",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "expo-widgets": "~57.0.6",
    "fractional-indexing": "^3.2.0",
    "heroui-native": "^1.0.5",
    "i18next": "^26.1.0",
    "katex": "0.17.0",
    "ollama-ai-provider-v2": "3.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.7",
    "react-native": "0.86.0",
    "react-native-chart-kit": "7.0.2",
    "react-native-enriched-markdown": "1.0.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "^1.21.13",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-healthkit": "1.0.0",
    "react-native-nitro-image": "0.15.1",
    "react-native-nitro-modules": "0.35.9",
    "react-native-nitro-theme-transition": "^1.0.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.1",
    "react-native-streamdown": "0.2.0",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "5.0.11",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.2",
    "reflect-metadata": "^0.2.2",
    "remend": "1.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "tokenx": "^1.1.0",
    "uniwind": "^1.6.4",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/preset-typescript": "^7.27.1",
