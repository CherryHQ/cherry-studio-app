{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "files.eol": "\n",
  "search.exclude": {
    "**/dist/**": true,
    ".yarn/releases/**": true,
    "ios/**": true,
    "android/**": true
  },
  "i18n-ally.localesPaths": ["src/frontend/i18n/locales"],
  "i18n-ally.keystyle": "flat",
  "i18n-ally.sourceLanguage": "en-us"
}
