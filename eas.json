{
  "cli": {
    "version": ">= 16.3.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "24.19.0",
      "pnpm": "12.2.1",
      "env": {
        "PROFILE": "development"
      },
      "android": {
        "buildType": "apk",
        "withoutCredentials": "true",
        "gradleCommand": ":app:assembleDebug -PreactNativeArchitectures=arm64-v8a"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Debug"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "24.19.0",
      "pnpm": "12.2.1",
      "env": {
        "PROFILE": "preview"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
      },
      "ios": {}
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "channel": "production",
      "node": "24.19.0",
      "pnpm": "12.2.1",
      "env": {
        "PROFILE": "production"
      },
      "android": {
        "buildType": "apk",
        "withoutCredentials": "true",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "GYM_XCARGS": "ARCHS=arm64"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6809783714"
      }
    }
  }
}
