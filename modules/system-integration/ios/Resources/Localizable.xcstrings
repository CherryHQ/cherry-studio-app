    "Open Cherry, send a question to an Agent, and return its answer. The conversation is saved in Cherry. Tool permissions still require approval in the app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Cherry, send a question to an Agent, and return its answer. The conversation is saved in Cherry. Tool permissions still require approval in the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Cherry，向 Agent 提问并返回回答。聊天会保存在 Cherry 中，工具权限仍需在应用内审批。"
          }
        }
      }
    },
