{
  "name": "@cherrystudio/ui",
  "version": "0.0.1-alpha.1",
  "description": "Shared native UI components for Cherry Studio",
  "homepage": "https://github.com/CherryHQ/cherry-studio-app",
  "author": "Cherry Studio",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "codegenConfig": {
    "name": "CherryStudioUISpec",
    "type": "all",
    "jsSrcsDir": "./src",
    "android": {
      "javaPackageName": "com.margelo.nitro.cherrystudio.ui"
    }
  },
  "scripts": {
    "icons:generate": "tsx src/scripts/generate-icons.ts",
    "icons:generate:webp": "tsx src/scripts/generate-icons.ts",
    "icons:generate:general": "tsx src/scripts/generate-icons.ts --type=general",
    "icons:generate:models": "tsx src/scripts/generate-icons.ts --type=models",
    "provider-icons:generate": "tsx src/scripts/generate-icons.ts --type=providers",
    "native:codegen": "nitrogen"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "react-native": "./src/components/index.ts",
      "import": "./src/components/index.ts",
      "default": "./src/components/index.ts"
    },
    "./background-activity": {
      "types": "./src/background-activity/index.ts",
      "react-native": "./src/background-activity/index.ts",
      "import": "./src/background-activity/index.ts",
      "default": "./src/background-activity/index.ts"
    },
    "./background-activity/ios": {
      "types": "./src/background-activity/background-activity.ios.tsx",
      "react-native": "./src/background-activity/background-activity.ios.tsx",
      "import": "./src/background-activity/background-activity.ios.tsx",
      "default": "./src/background-activity/background-activity.ios.tsx"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "react-native": "./src/utils/index.ts",
      "import": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    },
    "./motion": {
      "types": "./src/motion.ts",
      "react-native": "./src/motion.ts",
      "import": "./src/motion.ts",
      "default": "./src/motion.ts"
    },
    "./icons": {
      "types": "./src/icons/index.ts",
      "react-native": "./src/icons/index.ts",
      "import": "./src/icons/index.ts",
      "default": "./src/icons/index.ts"
    },
    "./icons/general": {
      "types": "./src/icons-webp/general/index.ts",
      "react-native": "./src/icons-webp/general/index.ts",
      "import": "./src/icons-webp/general/index.ts",
      "default": "./src/icons-webp/general/index.ts"
    },
    "./icons/models": {
      "types": "./src/icons-webp/models/index.ts",
      "react-native": "./src/icons-webp/models/index.ts",
      "import": "./src/icons-webp/models/index.ts",
      "default": "./src/icons-webp/models/index.ts"
    },
    "./icons/providers": {
      "types": "./src/icons-webp/providers/index.ts",
      "react-native": "./src/icons-webp/providers/index.ts",
      "import": "./src/icons-webp/providers/index.ts",
      "default": "./src/icons-webp/providers/index.ts"
    }
  },
  "peerDependencies": {
    "@expo/ui": "*",
    "@legendapp/list": "*",
    "@magrinj/expo-quick-look": "*",
    "@react-native-masked-view/masked-view": "*",
    "@shopify/react-native-skia": "*",
    "@swmansion/react-native-bottom-sheet": "*",
    "expo-blur": "*",
    "expo-file-system": "*",
    "expo-glass-effect": "*",
    "expo-haptics": "*",
    "expo-image": "*",
    "expo-linear-gradient": "*",
    "expo-paste-input": "*",
    "expo-screen-corner-radius": "*",
    "expo-widgets": "*",
    "heroui-native": "*",
    "@cherrystudio/app-icons": "workspace:*",
    "react": "*",
    "react-native": "*",
    "react-native-enriched-markdown": "*",
    "react-native-gesture-handler": "*",
    "react-native-keyboard-controller": "*",
    "react-native-nitro-modules": "*",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*",
    "react-native-streamdown": "*",
    "react-native-worklets": "*",
    "uniwind": "*"
  },
  "devDependencies": {
    "nitrogen": "0.35.9"
  }
}
