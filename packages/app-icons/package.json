{
  "name": "@cherrystudio/app-icons",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./icons/*": {
      "types": "./src/icons/*.tsx",
      "react-native": "./src/icons/*.tsx",
      "import": "./src/icons/*.tsx",
      "default": "./src/icons/*.tsx"
    }
  },
  "dependencies": {
    "lucide-react-native": "1.33.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-svg": "*",
    "uniwind": "*"
  }
}
