{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!.agents",
      "!.context",
      "!.expo",
      "!.vscode",
      "!android",
      "!ios",
      "!assets",
      "!patches",
      "!node_modules",
      "!dist",
      "!web-build",
      "!packages/ai-core",
      "!packages/ai-sdk-provider",
      "!packages/lucide-uniwind/src/index.ts",
      "!packages/lucide-uniwind/src/icons",
      "!packages/design-tokens/scripts/theme-contract.ts",
      "!packages/design-tokens/src/styles",
      "!packages/ui/src/icons-webp/general",
      "!packages/ui/src/icons-webp/models",
      "!packages/ui/src/icons-webp/providers",
      "!packages/ui/src/icons/desktop-routing.ts",
      "!src/types/uniwind-types.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "useArrowFunction": "off"
      },
      "style": {
        "useNodejsImportProtocol": "off",
        "useImportType": "off"
      },
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/shared/data/cache/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
