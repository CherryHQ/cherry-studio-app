# Configure GitHub OAuth only for production. For local production builds, copy these entries
# into .env.local, or run: eas env:pull --environment production
# Do not configure these variables for development or preview.
# Register an OAuth App (not a GitHub App).
# Production callback: cherrystudio://plugins/github/callback
EXPO_PUBLIC_GITHUB_OAUTH_CLIENT_ID=
EXPO_PUBLIC_GITHUB_OAUTH_CLIENT_SECRET=

# Both values are embedded in the client bundle. The client secret is a public-client
# credential used with PKCE; never add a GitHub App private key or user access token.
# Use EAS Plain text for the ID and Sensitive for the secret, not Secret visibility.

# Optional public CherryIN OAuth client ID; defaults to the existing Cherry Studio public client.
# The account server must register the callback for the build profile being used:
# production: cherrystudio://oauth/callback
# development: cherrystudio-dev://oauth/callback
# preview: cherrystudio-preview://oauth/callback
# No client secret. Never put access tokens or refresh tokens here.
EXPO_PUBLIC_CHERRYIN_OAUTH_CLIENT_ID=
