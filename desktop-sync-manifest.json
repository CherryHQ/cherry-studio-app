{
  "schemaVersion": 1,
  "repository": "https://github.com/CherryHQ/cherry-studio.git",
  "delegatedManifests": {
    "design": "packages/design-tokens/src/sync-manifest.json"
  },
  "domains": {
    "design-catalog": {
      "strategy": "semantic-port",
      "status": "unbaselined",
      "sourcePaths": [
        "packages/ui/icons",
        "packages/ui/src/components/icons/registry.ts",
        "packages/ui/src/components/icons/models",
        "packages/ui/src/components/icons/providers"
      ],
      "targetPaths": ["packages/ui/icons", "packages/ui/src/icons", "packages/ui/src/icons-webp"],
      "sourceCommit": null,
      "sourceSha256": null,
      "explicitExclusions": [],
      "virtualIconAdapters": {
        "opencode": "general/open-code"
      }
    },
    "schema": {
      "strategy": "opaque-retention",
      "status": "unbaselined",
      "sourcePaths": ["src/main/data/db/schemas", "migrations/sqlite-drizzle/meta"],
      "targetPaths": ["src/backend/data/db/schemas", "migrations/sqlite-drizzle/meta"],
      "sourceCommit": null,
      "sourceSha256": null,
      "explicitExclusions": []
    },
    "shared-data": {
      "strategy": "semantic-port",
      "status": "unbaselined",
      "sourcePaths": ["src/shared/data"],
      "targetPaths": ["src/shared/data"],
      "sourceCommit": null,
      "sourceSha256": null,
      "explicitExclusions": [
        "src/shared/data/bootConfig/**",
        "src/shared/data/migration/**",
        "src/shared/data/presets/binaryTools.ts",
        "src/shared/data/presets/claudeCode.ts",
        "src/shared/data/presets/codex.ts",
        "src/shared/data/presets/grokCli.ts",
        "src/shared/data/presets/localEmbedding.ts",
        "src/shared/data/presets/localModel.ts",
        "src/shared/data/types/fileProcessing.ts",
        "src/shared/data/types/settingsPath.ts"
      ],
      "shapeOnlyPorts": [
        {
          "path": "src/shared/data/preference/preferenceTypes.ts",
          "keeps": "DB-backed preference types",
          "drops": "BootConfigPreferenceKeys intersection in UnifiedPreferenceType (Electron boot-config file does not exist on mobile)"
        }
      ],
      "mobilePreferenceExtensions": [
        "permissions.calendar_read",
        "permissions.calendar_write",
        "permissions.health_read",
        "permissions.location_read",
        "permissions.reminders_read",
        "permissions.reminders_write"
      ]
    },
    "shared-portable": {
      "strategy": "semantic-port",
      "status": "unbaselined",
      "sourcePaths": [
        "src/shared/types/aiSdk.ts",
        "src/shared/types/codeCli.ts",
        "src/shared/types/error.ts",
        "src/shared/types/serializable.ts",
        "src/shared/utils/conversationTitle.ts",
        "src/shared/utils/keywordSearch.ts",
        "src/shared/utils/model.ts",
        "src/shared/utils/shortcut.ts",
        "src/shared/utils/text.ts",
        "src/shared/utils/url.ts"
      ],
      "targetPaths": [
        "src/shared/types/aiSdk.ts",
        "src/shared/types/codeCli.ts",
        "src/shared/types/error.ts",
        "src/shared/types/serializable.ts",
        "src/shared/utils/conversationTitle.ts",
        "src/shared/utils/keywordSearch.ts",
        "src/shared/utils/model.ts",
        "src/shared/utils/shortcut.ts",
        "src/shared/utils/text.ts",
        "src/shared/utils/url.ts"
      ],
      "sourceCommit": null,
      "sourceSha256": null,
      "explicitExclusions": [],
      "shapeOnlyPorts": [
        {
          "path": "src/shared/types/codeCli.ts",
          "keeps": "CodeCli enum backing the seeded feature.code_cli.configs preference value",
          "drops": "TerminalApp/TerminalConfig launch configs, CLI gateway and own-login virtual provider ids (mobile cannot launch CLIs)"
        },
        {
          "path": "src/shared/utils/shortcut.ts",
          "keeps": "Shortcut token vocabulary, ShortcutToken/ShortcutBinding types, isShortcutToken guard backing seeded shortcut.* preference values",
          "drops": "Accelerator/hotkey conversion, key display formatting, binding validation for the desktop command system"
        }
      ]
    },
    "data-main": {
      "strategy": "semantic-port",
      "status": "unbaselined",
      "sourcePaths": ["src/main/data"],
      "targetPaths": ["src/backend/data"],
      "sourceCommit": null,
      "sourceSha256": null,
      "explicitExclusions": ["src/main/data/migration/v2/**"]
    },
    "data-renderer": {
      "strategy": "semantic-port",
      "status": "unbaselined",
      "sourcePaths": ["src/renderer/data"],
      "targetPaths": ["src/frontend/data"],
      "sourceCommit": null,
      "sourceSha256": null,
      "explicitExclusions": []
    },
    "ai-core": {
      "strategy": "mirror",
      "status": "aligned",
      "sourcePaths": ["packages/aiCore"],
      "targetPaths": ["packages/ai-core"],
      "sourceCommit": "55feedb21473daf04792962db81ca66ab53e58a0",
      "sourceSha256": "dc1f733dfa854485159ca13786c75cbe0a70788a1a1d6a99a21ced05fa91dddb",
      "explicitExclusions": []
    },
    "ai-sdk-provider": {
      "strategy": "mirror",
      "status": "aligned",
      "sourcePaths": ["packages/ai-sdk-provider"],
      "targetPaths": ["packages/ai-sdk-provider"],
      "sourceCommit": "55feedb21473daf04792962db81ca66ab53e58a0",
      "sourceSha256": "36ab81e817c191119608b0bffc0339fe11da66bb28e5bbd556f01ff36b893af1",
      "explicitExclusions": []
    },
    "provider-registry": {
      "strategy": "semantic-port",
      "status": "unbaselined",
      "sourcePaths": ["packages/provider-registry"],
      "targetPaths": ["packages/provider-registry"],
      "sourceCommit": null,
      "sourceSha256": null,
      "explicitExclusions": []
    },
    "ai-runtime": {
      "strategy": "semantic-port",
      "status": "unbaselined",
      "sourcePaths": ["src/main/ai"],
      "targetPaths": ["src/backend/ai", "src/backend/services/chat"],
      "sourceCommit": null,
      "sourceSha256": null,
      "explicitExclusions": [
        "src/main/ai/agentSession/**",
        "src/main/ai/agents/**",
        "src/main/ai/observability/adapters/claudeCode/**",
        "src/main/ai/runtime/claudeCode/**",
        "src/main/ai/tools/adapters/claudeCode/**"
      ]
    },
    "shared-ai": {
      "strategy": "semantic-port",
      "status": "unbaselined",
      "sourcePaths": ["src/shared/ai"],
      "targetPaths": ["src/shared/ai"],
      "sourceCommit": null,
      "sourceSha256": null,
      "explicitExclusions": [
        "src/shared/ai/agentSessionApiRetry.ts",
        "src/shared/ai/agentSessionBackgroundTasks.ts",
        "src/shared/ai/agentSessionContextUsage.ts",
        "src/shared/ai/agentSessionFlowParts.ts",
        "src/shared/ai/agentSessionSlashCommands.ts",
        "src/shared/ai/agentSlashCommands.ts",
        "src/shared/ai/claudecode/**",
        "src/shared/ai/slashCommands.ts",
        "src/shared/ai/tool.ts"
      ],
      "shapeOnlyPorts": [
        {
          "path": "src/shared/ai/prompts.ts",
          "keeps": "TRANSLATE_PROMPT — seeded default of feature.translate.model_prompt",
          "drops": "AGENT_PROMPT/SUMMARIZE_PROMPT/LANG_DETECT_PROMPT desktop templates with no mobile consumer"
        }
      ]
    },
    "services": {
      "strategy": "semantic-port",
      "status": "unbaselined",
      "sourcePaths": ["src/main/services"],
      "targetPaths": ["src/backend/services", "src/backend/data/services", "src/backend/ai"],
      "sourceCommit": null,
      "sourceSha256": null,
      "explicitExclusions": []
    },
    "dependencies": {
      "strategy": "semantic-port",
      "status": "unbaselined",
      "sourcePaths": ["package.json", "pnpm-lock.yaml", "patches"],
      "targetPaths": ["package.json", "pnpm-lock.yaml", "patches"],
      "sourceCommit": null,
      "sourceSha256": null,
      "explicitExclusions": []
    },
    "backup": {
      "strategy": "opaque-retention",
      "status": "blocked",
      "sourcePaths": [
        "src/main/services/LegacyBackupManager.ts",
        "src/main/data/db/restore",
        "src/main/data/CacheService.ts"
      ],
      "targetPaths": ["src/backend/data", "src/backend/services"],
      "sourceCommit": null,
      "sourceSha256": null,
      "explicitExclusions": [],
      "blocker": "Desktop v7 direct backups archive Data/cherrystudio.sqlite, resources, cache.json, and the desktop migration chain; mobile currently uses cherry.db, a different migration chain, and MMKV cache, so it cannot produce or restore that archive losslessly."
    }
  }
}
